# Port Server Backend
PORT=8080

# Koneksi PostgreSQL (Ganti dengan kredensial database VPS Anda)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learning_bahasa?sslmode=disable

# Rahasia JWT Token (Ganti dengan string acak panjang di production)
JWT_SECRET=super-secret-jwt-key-learning-bahasa-2026-very-secure

# Google OAuth Client ID (Opsional, untuk login Google)
GOOGLE_CLIENT_ID=

# URL Frontend (Astro)
FRONTEND_URL=https://learning-bahasa-news.vercel.app
